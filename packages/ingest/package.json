{
  "name": "@quick-bug-reporter/ingest",
  "version": "0.1.0",
  "description": "Runtime-agnostic ingest contract, parser, and handler for QuickBugs reports.",
  "homepage": "https://github.com/AAALI/Quickbugs/tree/main/packages/ingest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AAALI/Quickbugs.git",
    "directory": "packages/ingest"
  },
  "bugs": {
    "url": "https://github.com/AAALI/Quickbugs/issues"
  },
  "author": "Ali Abdulkadir Ali",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "bug-reporter",
    "ingest",
    "self-hosted",
    "quickbugs"
  ],
  "devDependencies": {
    "@quick-bug-reporter/core": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "^5"
  }
}
