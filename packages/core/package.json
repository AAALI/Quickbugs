{
  "name": "@quick-bug-reporter/core",
  "version": "1.3.0",
  "description": "Capture engine, privacy controls, and tracker integrations shared by all QuickBugs SDKs.",
  "homepage": "https://github.com/AAALI/Quickbugs/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AAALI/Quickbugs.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/AAALI/Quickbugs/issues"
  },
  "author": "Ali Abdulkadir Ali",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "bug-reporter",
    "screenshot",
    "screen-recording",
    "privacy",
    "linear",
    "jira"
  ],
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5"
  },
  "dependencies": {
    "html2canvas-pro": "^1.6.6"
  }
}
